<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Development. A build signed with this entitlement gets a token that is
	     only valid on api.sandbox.push.apple.com; a TestFlight or App Store
	     build is re-signed to `production` automatically and its token is only
	     valid on api.push.apple.com. The app reports which one it holds when it
	     registers, because the daemon cannot tell from the token itself. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Attest. Like aps-environment, `development` here attests against
	     Apple's sandbox App Attest servers, and a TestFlight or App Store build is
	     re-signed to `production` automatically. The relay verifies the matching
	     AAGUID per namespace, so the two stay paired: a development build enrolls
	     on the sandbox namespace, a distribution build on production. Requires the
	     App Attest capability on the App ID in the Apple Developer portal. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>development</string>
</dict>
</plist>
